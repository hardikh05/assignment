# ===========================================
# Server Configuration
# ===========================================
PORT=5000
NODE_ENV=development

# ===========================================
# MongoDB
# ===========================================
MONGODB_URI=mongodb://localhost:27017/mini-crm

# ===========================================
# Authentication
# ===========================================
# REQUIRED: A strong random secret for signing JWT tokens
JWT_SECRET=change-me-to-a-strong-random-string

# Google OAuth 2.0 credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ===========================================
# Frontend URL (for CORS and redirects)
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# AI Providers (at least one recommended)
# ===========================================
# OpenAI API key (used for segment rule conversion)
OPENAI_API_KEY=your-openai-api-key

# Google Gemini API key (used for campaign message generation)
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# Kafka (optional - messaging queue)
# ===========================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mini-crm
KAFKA_GROUP_ID=mini-crm-group
